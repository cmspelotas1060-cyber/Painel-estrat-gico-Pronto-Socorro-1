rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 1024; 
    }

    function isValidAppData(data) {
      return data.id is string &&
             data.data != null;
    }

    match /app_data/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
                             request.resource.data.id == id &&
                             isValidAppData(request.resource.data);
      allow delete: if true;
    }

    match /shares/{id} {
      allow read: if true;
      allow create: if isValidId(id) && 
                    request.resource.data.payload != null;
      allow update, delete: if false;
    }
  }
}
