rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 1024; 
    }

    function isValidAppData(data) {
      return data.keys().hasAll(['id', 'data', 'updatedAt']) &&
             data.id is string &&
             (data.updatedAt is timestamp || data.updatedAt == null);
    }

    match /app_data/{id} {
      allow read: if true;
      allow write: if isValidId(id) && 
                     request.resource.data.id == id &&
                     isValidAppData(request.resource.data);
    }

    match /shares/{id} {
      allow read: if true;
      allow create: if isValidId(id) && 
                    request.resource.data.keys().hasAll(['payload', 'createdAt']) &&
                    request.resource.data.payload != null;
    }
  }
}
